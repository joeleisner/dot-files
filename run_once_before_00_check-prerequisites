#!/usr/bin/env bash

DEPENDENCIES=("git")
MISSING_DEPS=()

for dep in "${DEPENDENCIES[@]}"; do
	if ! command -v "$dep" &> /dev/null; then
		MISSING_DEPS+=("$dep")
	fi
done

if [ ${#MISSING_DEPS[@]} -ne 0 ]; then
	echo "❌ Error: Missing required dependencies." >&2
	echo "Please install the following packages first: ${MISSING_DEPS[*]}" >&2
	exit 1
else
	echo "✅️ Required dependencies already installed."
fi

# Soft check: proj's default agent, but not needed to apply these dot files
if ! command -v claude &> /dev/null; then
	echo "💡 Claude Code isn't installed (proj uses it). After setup, run: mise run install-claude"
fi
