{{- $onepasswordCmd := includeTemplate "onepassword-cmd" . -}}
[user]
	name = {{ .git_name | quote }}
	email = {{ .git_email | quote }}
{{- if lookPath $onepasswordCmd }}
	signingkey = {{ onepasswordRead .git_signing_key | trim }}
{{- end }}

[commit]
	gpgsign = {{ if lookPath $onepasswordCmd }}true{{ else }}false{{ end }}

[core]
	# Git opens a short-lived connection per operation; skip ssh multiplexing so
	# it never races for (or hangs on) a ControlMaster socket
	sshCommand = ssh -o ControlMaster=no -o ControlPath=none

[gpg]
	format = ssh

[gpg "ssh"]
{{- if lookPath $onepasswordCmd }}
	allowedSignersFile = ~/.config/git/allowed_signers
{{- end }}
{{- if and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) }}
	program = "op-ssh-sign.exe"
{{- else }}
	program = "op-ssh-sign"
{{- end }}

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
