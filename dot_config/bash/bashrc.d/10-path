# Setup entries as a standard POSIX colon-separated list
_entries="$HOME/.local/bin${CARGO_HOME:+:$CARGO_HOME/bin}"
mkdir -p "$HOME/.local/bin"

_rest="$_entries:$PATH"
_new_path=
_seen=
while [ -n "$_rest" ]; do
    # Split on ":" with parameter expansion (zsh doesn't word-split $vars)
    case $_rest in
        *:*) _dir=${_rest%%:*}; _rest=${_rest#*:} ;;
        *)   _dir=$_rest; _rest= ;;
    esac
    [ -n "$_dir" ] && [ -d "$_dir" ] || continue
    # Dedupe on the symlink-resolved path, but keep the original entry
    _real=$(cd "$_dir" 2>/dev/null && pwd -P) || continue
    case ":$_seen:" in
        *":$_real:"*) ;;
        *)
            _seen=${_seen:+$_seen:}$_real
            _new_path=${_new_path:+$_new_path:}$_dir
            ;;
    esac
done

[ -n "$_new_path" ] && PATH=$_new_path
export PATH
unset _entries _rest _new_path _seen _dir _real
