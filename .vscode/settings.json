{
	"files.associations": {
		// Shell
		"*.sh.tmpl": "shellscript",
		"*.tmpl": "shellscript",
		"executable_*": "shellscript",
		"dot_bash_profile": "shellscript",
		"dot_bashrc": "shellscript",
		"dot_zshrc": "shellscript",
		"**/bashrc.d/*": "shellscript",
		"**/zshrc.d/*": "shellscript",
		"run_once*": "shellscript",
		"run_onchange*": "shellscript",
		// Ignored
		"**/symlink_*": "ignore",
		// Properties
		"**/npmrc": "properties",
		// SSH config
		"private_config": "ssh-config",
		"Brewfile-*": "ruby",
	}
}