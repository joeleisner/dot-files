#!/usr/bin/env bash

if [ -z "$1" ]; then
	echo "key path missing"
	exit 1
fi

if [ -z "$2" ]; then
	echo "cert path missing"
	exit 1
fi

keyChecksum=$(openssl pkey -in $1 -pubout -outform pem | sha256sum)
certChecksum=$(openssl x509 -in $2 -pubkey -noout -outform pem | sha256sum)

if [[ "$keyChecksum" == "$certChecksum" ]]; then
	echo "key/cert checksums match!"
else
	echo "key/cert checksums DO NOT match!"
fi

echo "key:  $keyChecksum"
echo "cert: $certChecksum"