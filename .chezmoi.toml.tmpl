{{- $onepasswordCmd := includeTemplate "onepassword-cmd" . -}}

{{- /* Prompt for details up front during initialization */ -}}
{{- $gitName := promptStringOnce . "git_name" "Enter git name" -}}
{{- $gitEmail := promptStringOnce . "git_email" "Enter git email" -}}
{{- $gitSigningKey := promptStringOnce . "git_signing_key_uri" "Enter 1Password git signing key URI" -}}

[onePassword]
	command = {{ $onepasswordCmd | quote }}

[data]
	# Git Identity
	git_name = {{ $gitName | quote }}
	git_email = {{ $gitEmail | quote }}
	git_signing_key = {{ $gitSigningKey | quote }}
